; The Lock_File deps/lock.toml (R7.7). Codec:
; crates/dp-formats/src/lockfile.rs (`LockFile`). The file is TOML in one
; layout; a text in any other layout, or with a comment, is refused
; (R7.10 criterion 8). Every line ends with a line feed.

lock-file       = header *tool
header          = %s"# Lock_File (R7.7). Generated by deps/gen-lock.sh; do not edit." LF

tool            = LF %s"[[tool]]" LF
                  %s"name = " string LF
                  %s"version = " string LF          ; not empty
                  %s"kind = " DQUOTE kind DQUOTE LF
                  [ %s"prover = " string LF ]       ; required for the two kinds of solver
                  [ %s"patches = " strings LF ]     ; not empty; never with the kind unpatched-solver
                  *platform
kind            = %s"unpatched-solver" / %s"sharing-solver" / %s"checker" / %s"checker-signature"
                / %s"alethe-rule-list" / %s"why3" / %s"why3find" / %s"creusot" / %s"lean" / %s"tla"
                / %s"kani" / %s"cargo-mutants" / %s"toolchain" / %s"library"

platform        = LF %s"[[tool.platform]]" LF
                  %s"platform = " string LF
                  %s"hash = " DQUOTE hash DQUOTE LF
                  [ %s"upstream = { " [ %s"published_checksum = " string %s", " ]
                                      [ %s"tag = " string %s", " ]
                                      %s"rebuild_hashes = " strings %s" }" LF ]
hash            = %s"sha256:" 64HEXLOW

strings         = "[" [ string *( %s", " string ) ] "]"
string          = DQUOTE *plain DQUOTE
plain           = %x20-21 / %x23-5B / %x5D-7E / %x80-10FFFF   ; no quote, no backslash, no control character
HEXLOW          = %x30-39 / %x61-66
DQUOTE          = %x22
LF              = %x0A
