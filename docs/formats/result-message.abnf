; The Result message (R1.3 criterion 8): what a Worker signs and the
; Coordinator passes on. Codec: crates/dp-formats/src/cluster.rs
; (`Message::Result`, `SignedResult`, `ResultFields`). An input that is
; not the canonical print of the value that it parses to is rejected.

result-message  = "(" %s"6:result" result-fields signature ")"

result-fields   = "(" text            ; the Job
                      hash            ; the Task_Hash of the print that was run
                      text            ; the prover
                      optional-number ; the seed of a race member
                      hash            ; the hash of the solver binary
                      text            ; the Worker
                      optional-number ; the exit status; none when the run was ended
                      end
                      bytes           ; what the solver printed
                      number          ; elapsed microseconds
                      number          ; the Worker's Calibration
                      number          ; the local time limit in microseconds
                      hash            ; the hash of the import set
                  ")"
optional-number = "(" [number] ")"
end             = %s"9:timed-out" / %s"6:exited"
signature       = %s"64:" 64OCTET     ; Ed25519, over the print of result-fields

; Shared rules. Every value is a canonical S-expression
; (canonical-sexp.abnf): an atom is its length in decimal, a colon and
; that many octets; a list has no whitespace between its items.

hash    = %s"32:" 32OCTET
number  = atom                        ; its octets are a decimal number below 2^64 without leading zeros
text    = atom                        ; its octets are UTF-8
bytes   = atom
atom    = length ":" *OCTET           ; exactly <length> octets follow the colon
length  = "0" / (%x31-39 *DIGIT)
DIGIT   = %x30-39
OCTET   = %x00-FF
