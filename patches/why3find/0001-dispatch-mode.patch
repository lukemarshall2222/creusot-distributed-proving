diff --git a/src/dispatch.ml b/src/dispatch.ml
new file mode 100644
index 0000000..bbb85db
--- /dev/null
+++ b/src/dispatch.ml
@@ -0,0 +1,305 @@
+(**************************************************************************)
+(*                                                                        *)
+(*  SPDX-License-Identifier LGPL-2.1                                      *)
+(*  Copyright (C)                                                         *)
+(*  CEA (Commissariat à l'énergie atomique et aux énergies alternatives)  *)
+(*                                                                        *)
+(**************************************************************************)
+
+(* -------------------------------------------------------------------------- *)
+(* --- Why3 Runner                                                        --- *)
+(* -------------------------------------------------------------------------- *)
+(* -------------------------------------------------------------------------- *)
+(* --- Dispatch Mode                                                      --- *)
+(* -------------------------------------------------------------------------- *)
+
+type sexp = A of string | L of sexp list
+
+let fatal fmt =
+  Format.kasprintf
+    (fun msg -> prerr_endline ("why3find: dispatch: " ^ msg) ; Unix._exit 3) fmt
+
+(* -------------------------------------------------------------------------- *)
+(* --- Canonical S-Expressions                                            --- *)
+(* -------------------------------------------------------------------------- *)
+
+let rec print b = function
+  | A s ->
+    Buffer.add_string b (string_of_int (String.length s)) ;
+    Buffer.add_char b ':' ;
+    Buffer.add_string b s
+  | L xs -> Buffer.add_char b '(' ; List.iter (print b) xs ; Buffer.add_char b ')'
+
+exception Incomplete
+
+let parse s pos =
+  let n = String.length s in
+  let rec item i =
+    if i >= n then raise Incomplete else
+      match s.[i] with
+      | '(' -> list (i+1) []
+      | '0'..'9' -> atom i i
+      | c -> fatal "malformed message (byte %C)" c
+  and list i acc =
+    if i >= n then raise Incomplete else
+    if s.[i] = ')' then L (List.rev acc), i+1 else
+      let x,j = item i in list j (x::acc)
+  and atom i0 i =
+    if i >= n then raise Incomplete else
+      match s.[i] with
+      | '0'..'9' when i - i0 < 9 && (i = i0 || s.[i0] <> '0') -> atom i0 (i+1)
+      | ':' ->
+        let len = int_of_string (String.sub s i0 (i - i0)) in
+        if i + 1 + len > n then raise Incomplete else
+          A (String.sub s (i+1) len), i + 1 + len
+      | _ -> fatal "malformed message (atom length)"
+  in item pos
+
+(* -------------------------------------------------------------------------- *)
+(* --- Channel                                                            --- *)
+(* -------------------------------------------------------------------------- *)
+
+let enabled = ref false
+let active () = !enabled
+let output = ref Unix.stdout
+let input = Buffer.create 4096
+let replies : (string, sexp) Hashtbl.t = Hashtbl.create 64
+
+let send msg =
+  let b = Buffer.create 256 in
+  print b msg ;
+  let s = Buffer.to_bytes b in
+  let n = Bytes.length s in
+  let rec write k =
+    if k < n then write (k + Unix.write !output s k (n - k)) in
+  try write 0 with Unix.Unix_error _ -> fatal "pipe closed"
+
+let enable () =
+  if not !enabled then
+    begin
+      enabled := true ;
+      Proofs.deferred := true ;
+      Sys.set_signal Sys.sigpipe Sys.Signal_ignore ;
+      flush stdout ;
+      output := Unix.dup Unix.stdout ;
+      Unix.dup2 Unix.stderr Unix.stdout ;
+      send (L [A "hello" ; A "1"]) ;
+    end
+
+let counter = ref 0
+let fresh () = incr counter ; string_of_int !counter
+
+let micro t = string_of_int (int_of_float (Float.round (t *. 1e6)))
+let of_micro s =
+  try float_of_int (int_of_string s) /. 1e6
+  with Failure _ -> fatal "malformed message (number %S)" s
+
+let of_result : Result.t -> sexp = function
+  | NoResult -> L [A "noresult"]
+  | Failed -> L [A "failed"]
+  | Valid t -> L [A "valid" ; A (micro t)]
+  | Unknown t -> L [A "unknown" ; A (micro t)]
+  | Timeout t -> L [A "timeout" ; A (micro t)]
+
+let to_result : sexp -> Result.t = function
+  | L [A "noresult"] -> NoResult
+  | L [A "failed"] -> Failed
+  | L [A "valid" ; A t] -> Valid (of_micro t)
+  | L [A "unknown" ; A t] -> Unknown (of_micro t)
+  | L [A "timeout" ; A t] -> Timeout (of_micro t)
+  | _ -> fatal "malformed message (result)"
+
+(* -------------------------------------------------------------------------- *)
+(* --- Requests of the Parent Process                                     --- *)
+(* -------------------------------------------------------------------------- *)
+
+let context = ref None
+let goals : (string, Session.goal) Hashtbl.t = Hashtbl.create 256
+
+let configure project profile provers =
+  context := Some (project, profile, provers)
+
+let task_print task =
+  Why3.Pretty.forget_all () ;
+  Format.asprintf "%a" Why3.Pretty.print_task task
+
+let rec path goal =
+  match Session.parent goal with
+  | None -> []
+  | Some parent ->
+    let tactic = Option.fold ~none:"" ~some:Tactic.name (Session.tactic parent) in
+    let rec index i = function
+      | [] -> -1 | g::gs -> if g == goal then i else index (i+1) gs in
+    let step = [A tactic ; A (string_of_int (index 0 (Session.children parent)))] in
+    path parent @ [L step]
+
+let announce goal =
+  let gid = fresh () in
+  Hashtbl.add goals gid goal ;
+  let theory = (Session.theory goal).th_name.id_string in
+  send (L [ A "goal" ; A gid ; A (Session.file goal) ; A theory ;
+            A (Session.name goal) ; L (path goal) ;
+            A (task_print (Session.task goal)) ]) ;
+  gid
+
+let request qid (reply : unit -> unit) =
+  try reply () with
+  | Not_found -> send (L [A "error" ; A qid ; A "unknown goal or prover"])
+  | exn -> send (L [A "error" ; A qid ; A (Printexc.to_string exn)])
+
+let find_prover provers name =
+  List.find (fun p -> Prover.fullname p = name) provers
+
+let handle msg =
+  let (project : Project.t), profile, provers =
+    match !context with Some c -> c | None -> fatal "not configured" in
+  match msg with
+  | L [A ("cache" | "answer" | "stored") ; A rid ; reply] ->
+    Hashtbl.replace replies rid reply
+  | L [A "print" ; A qid ; A gid ; A prover ; L transformations] ->
+    request qid @@ fun () ->
+    let apply tasks = function
+      | A name -> List.concat_map (Why3.Trans.apply_transform name project.env) tasks
+      | L _ -> fatal "malformed message (transformation)" in
+    let prover = find_prover provers prover in
+    let task = Session.task (Hashtbl.find goals gid) in
+    let tasks = List.fold_left apply [task] transformations in
+    let bytes = match tasks with
+      | [task] -> Runner.data (Runner.prepare prover task) | _ -> "" in
+    send (L [A "printed" ; A qid ; A (string_of_int (List.length tasks)) ; A bytes])
+  | L [A "task-print" ; A qid ; A gid] ->
+    request qid @@ fun () ->
+    let task = Session.task (Hashtbl.find goals gid) in
+    send (L [A "task" ; A qid ; A (task_print task)])
+  | L [A "provers" ; A qid] ->
+    let prover (p : Prover.prover) =
+      let file = Why3.Driver.get_filename p.driver
+          ~input_file:"f" ~theory_name:"t" ~goal_name:"g" in
+      L [ A (Prover.fullname p) ; A p.digest ; A (snd p.config.driver) ;
+          A (Why3.Whyconf.get_complete_command p.config ~with_steps:false) ;
+          A (Filename.extension file) ] in
+    send (L (A "provers" :: A qid :: List.map prover provers))
+  | L [A "read-answer" ; A qid ; A prover ; A status ; A output] ->
+    request qid @@ fun () ->
+    (* The answer is read by Why3 with the driver of the prover: a command
+       that replays the recorded output and exit status stands for the run. *)
+    let prover = find_prover provers prover in
+    let status = try int_of_string status with Failure _ -> raise Not_found in
+    let out = Filename.temp_file "why3find" ".out" in
+    let script = Filename.temp_file "why3find" ".sh" in
+    Utils.writefile ~file:out output ;
+    Utils.writefile ~file:script
+      (Printf.sprintf "cat %s\nexit %d\n" (Filename.quote out) status) ;
+    let config = Why3.Whyconf.get_main project.whyconf in
+    let limits = Why3.Call_provers.{
+        limit_time = 60.0 ; limit_mem = Runner.memlimit config ; limit_steps = -1 } in
+    let call = Why3.Driver.prove_buffer_prepared ~command:("/bin/sh " ^ script)
+        ~config ~limits prover.driver (Buffer.create 0) in
+    let answer () =
+      match Why3.Call_provers.query_call call with
+      | ProverFinished pr ->
+        Some (match pr.pr_answer with
+            | Valid -> "valid" | Invalid -> "invalid" | Timeout -> "timeout"
+            | OutOfMemory -> "outofmemory"
+            | StepLimitExceeded -> "steplimitexceeded"
+            | Unknown _ -> "unknown" | Failure _ -> "failure"
+            | HighFailure _ -> "highfailure")
+      | InternalFailure _ -> Some "highfailure"
+      | NoUpdates | ProverStarted | ProverInterrupted -> None
+      | exception _ -> Some "highfailure" in
+    Fibers.background
+      ~callback:(fun answer ->
+          Utils.rmpath out ; Utils.rmpath script ;
+          send (L [A "answer-read" ; A qid ; A answer]))
+      (Fibers.async answer)
+  | L [A "calibration" ; A qid ; A prover] ->
+    request qid @@ fun () ->
+    let prover = find_prover provers prover in
+    let wmain = Why3.Whyconf.get_main project.whyconf in
+    Fibers.background
+      ~callback:(fun v -> send (L [A "calibration" ; A qid ; A (micro v)]))
+      (Calibration.velocity wmain project.cache profile prover)
+  | _ -> fatal "unexpected message"
+
+let chunk = Bytes.create 65536
+
+let pump ~block =
+  let ready,_,_ =
+    try Unix.select [Unix.stdin] [] [] (if block then (-1.0) else 0.0)
+    with Unix.Unix_error(Unix.EINTR,_,_) -> [],[],[] in
+  if ready <> [] then
+    begin
+      let n = try Unix.read Unix.stdin chunk 0 (Bytes.length chunk)
+        with Unix.Unix_error _ -> 0 in
+      if n = 0 then fatal "pipe closed" ;
+      Buffer.add_subbytes input chunk 0 n ;
+      let data = Buffer.contents input in
+      let rec loop pos =
+        match parse data pos with
+        | msg,next -> handle msg ; loop next
+        | exception Incomplete -> pos in
+      let pos = loop 0 in
+      Buffer.clear input ;
+      Buffer.add_substring input data pos (String.length data - pos) ;
+    end
+
+let yield () = if !enabled then pump ~block:false
+
+let poll rid =
+  pump ~block:false ;
+  match Hashtbl.find_opt replies rid with
+  | None -> None
+  | Some reply -> Hashtbl.remove replies rid ; Some reply
+
+let rec wait rid =
+  match poll rid with
+  | Some reply -> reply
+  | None -> pump ~block:true ; wait rid
+
+(* -------------------------------------------------------------------------- *)
+(* --- Prover Calls and Cache Accesses                                    --- *)
+(* -------------------------------------------------------------------------- *)
+
+let cache_get ~gid prover timeout =
+  let rid = fresh () in
+  send (L [ A "cache-get" ; A rid ; A gid ; A (Prover.fullname prover) ;
+            A (micro timeout) ]) ;
+  Result.crop ~timeout @@ to_result @@ wait rid
+
+let prove ~gid ~step ?cancel prover timeout =
+  let rid = fresh () in
+  send (L [ A "prove" ; A rid ; A gid ; A step ; A (Prover.fullname prover) ;
+            A (micro timeout) ]) ;
+  let canceled = ref false in
+  let handler () =
+    if not !canceled then (canceled := true ; send (L [A "cancel" ; A rid])) in
+  Fibers.monitor ?signal:cancel ~handler @@
+  Fibers.async (fun () -> Option.map to_result (poll rid))
+
+let cache_set ~gid prover result =
+  let rid = fresh () in
+  send (L [ A "cache-set" ; A rid ; A gid ; A (Prover.fullname prover) ;
+            of_result result ]) ;
+  match wait rid with
+  | A "store" -> true
+  | A "skip" -> false
+  | _ -> fatal "malformed message (stored)"
+
+(* -------------------------------------------------------------------------- *)
+(* --- Proof Files                                                        --- *)
+(* -------------------------------------------------------------------------- *)
+
+let deferred = ref []
+
+let defer action =
+  if !enabled then deferred := action :: !deferred else action ()
+
+let finish () =
+  if !enabled then
+    begin
+      List.iter (fun action -> action ()) (List.rev !deferred) ;
+      deferred := [] ;
+      send (L [A "done"]) ;
+    end
+
+(* -------------------------------------------------------------------------- *)
diff --git a/src/dispatch.mli b/src/dispatch.mli
new file mode 100644
index 0000000..17e7313
--- /dev/null
+++ b/src/dispatch.mli
@@ -0,0 +1,93 @@
+(**************************************************************************)
+(*                                                                        *)
+(*  SPDX-License-Identifier LGPL-2.1                                      *)
+(*  Copyright (C)                                                         *)
+(*  CEA (Commissariat à l'énergie atomique et aux énergies alternatives)  *)
+(*                                                                        *)
+(**************************************************************************)
+
+(* -------------------------------------------------------------------------- *)
+(* --- Why3 Runner                                                        --- *)
+(* -------------------------------------------------------------------------- *)
+(* -------------------------------------------------------------------------- *)
+(* --- Dispatch Mode                                                      --- *)
+(* -------------------------------------------------------------------------- *)
+
+(** Dispatch mode ([why3find prove --dispatch]).
+
+    In dispatch mode why3find still generates goals, runs its proof strategy
+    and tactics and writes its proof files, but it runs no prover and reads no
+    prover result from its cache. It sends every prover call and every access
+    to its prover cache to the parent process and waits for the answer.
+
+    Messages are canonical S-expressions, read from stdin and written to
+    stdout: an atom is [<decimal length>:<bytes>], a list is
+    [(<item>...)], and there is no whitespace. Regular output of why3find
+    goes to stderr. A closed pipe or a malformed message is fatal: why3find
+    exits with status 3 and writes no proof file.
+
+    Times and calibration factors are decimal integers, in microseconds and
+    in millionths. A result [<r>] is one of [(valid <t>)], [(unknown <t>)],
+    [(timeout <t>)], [(failed)] and [(noresult)]. A strategy step [<step>] is
+    [fast] (first sequential pass), [parallel] (reference-time parallel pass),
+    [parallel-long] or [replay].
+
+    From why3find to the parent:
+    - [(hello 1)], first message;
+    - [(goal <gid> <file> <theory> <name> ((<tactic> <index>)...) <task>)],
+      a new goal with its path and the print of its task, before any driver;
+    - [(cache-get <rid> <gid> <prover> <time>)], answered by [(cache <rid> <r>)];
+    - [(prove <rid> <gid> <step> <prover> <time>)], answered by
+      [(answer <rid> <r>)]; [(cancel <rid>)] asks for an early answer;
+    - [(cache-set <rid> <gid> <prover> <r>)], answered by
+      [(stored <rid> store)] or [(stored <rid> skip)];
+    - [(done)], after the proof files are written.
+
+    From the parent to why3find, each answered with the same [<qid>] or with
+    [(error <qid> <message>)]:
+    - [(print <qid> <gid> <prover> (<transformation>...))], answered by
+      [(printed <qid> <count> <bytes>)]: the number of tasks after the
+      transformations and, when it is one, the prover input that the driver
+      prints for it;
+    - [(task-print <qid> <gid>)], answered by [(task <qid> <task>)];
+    - [(provers <qid>)], answered by
+      [(provers <qid> (<prover> <digest> <driver> <command> <extension>)...)],
+      where [<extension>] is the extension of the prover's input file;
+    - [(read-answer <qid> <prover> <exit status> <output>)], answered by
+      [(answer-read <qid> <answer>)]: the answer that the driver of the prover
+      reads from the output and exit status of a run, one of [valid],
+      [invalid], [timeout], [outofmemory], [steplimitexceeded], [unknown],
+      [failure] and [highfailure];
+    - [(calibration <qid> <prover>)], answered by
+      [(calibration <qid> <velocity>)]. *)
+
+(** Switch to dispatch mode. *)
+val enable : unit -> unit
+
+val active : unit -> bool
+
+(** Environment used to answer the requests of the parent process. *)
+val configure : Project.t -> Calibration.profile -> Prover.prover list -> unit
+
+(** Announce a goal. Returns its identifier. *)
+val announce : Session.goal -> string
+
+val cache_get : gid:string -> Prover.prover -> float -> Result.t option
+
+val prove :
+  gid:string -> step:string -> ?cancel:unit Fibers.signal ->
+  Prover.prover -> float -> Result.t Fibers.t
+
+(** Returns [true] when the result shall be stored in the local cache. *)
+val cache_set : gid:string -> Prover.prover -> Result.t -> bool
+
+(** Process the pending messages of the parent process. *)
+val yield : unit -> unit
+
+(** Run now, or at [finish] in dispatch mode. *)
+val defer : (unit -> unit) -> unit
+
+(** Run the deferred actions and tell the parent process. *)
+val finish : unit -> unit
+
+(* -------------------------------------------------------------------------- *)
